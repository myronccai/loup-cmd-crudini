@mode(host.dual)

# Application identity and exit statuses for crudini. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual, but only ever interpreted here: bin/crudini.lpscr and
# lib/usage.loup import it under `loup run`, and the unit tests under
# Stage0's test runner. It holds only constants, so it stays compilable.

pub const APP_NAME: string = "crudini";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Query and edit INI files from the command line.";

# Exit statuses. crudini uses 1 for every failure, usage errors included.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
